# ─────────────────────────────────────────────────────────────────────────────
# .env.example  –  Copy this to .env for local dev, or set these as
#                  Environment Variables in your service dashboard.
# DO NOT commit .env with real values to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ──(PostgreSQL) ─────────────────────────────────────────────────────────
# Connection string from Neon dashboard → Connection Details → JDBC
# Example: jdbc:postgresql://<host>.neon.tech:5432/<dbname>?sslmode=require
DATABASE_URL=jdbc:postgresql://url:5432/<dbname>?sslmode=require
DATABASE_USERNAME=<username>
DATABASE_PASSWORD=<password>

# ── (Redis) ───────────────────────────────────────────────────────────
# Connection string from Upstash Console → REST API → Redis URL
# Must use the rediss:// (TLS) scheme, not redis://
REDIS_URL=rediss://default:<password>@url:6379

# ── Application ───────────────────────────────────────────────────────────────
# The public base URL that short links are built from (trailing slash included)
# On Render this will be your service URL, e.g. https://urlshortner.onrender.com/
BASE_URL=https://url.com/

# ── Injects this automatically; no need to set it manually ─────────────
# PORT=8080
